---
import '@fontsource-variable/big-shoulders/opsz.css';
import '@fontsource-variable/sofia-sans/index.css';
import '../styles/global.css';
import fontNaglowki from '@fontsource-variable/big-shoulders/files/big-shoulders-latin-opsz-normal.woff2?url';
import fontNaglowkiExt from '@fontsource-variable/big-shoulders/files/big-shoulders-latin-ext-opsz-normal.woff2?url';
import fontTekst from '@fontsource-variable/sofia-sans/files/sofia-sans-latin-wght-normal.woff2?url';
import Naglowek from '../components/Naglowek.astro';
import Stopka from '../components/Stopka.astro';
import PasekTelefonu from '../components/PasekTelefonu.astro';
import Ogloszenie from '../components/Ogloszenie.astro';
import { firma, dzialy } from '../data/firma';

interface Props {
  tytul: string;
  opis: string;
  obrazOg?: string;
  /** strony, ktorych wyszukiwarka nie ma pokazywac (404) */
  bezIndeksu?: boolean;
}
const { tytul, opis, obrazOg = '/og.jpg', bezIndeksu = false } = Astro.props;
const glowna = Astro.url.pathname === '/';
const pelnyTytul = tytul === 'PHU Probud' ? 'PHU Probud: maszyny budowlane BOMAG, Komorniki k. Poznania' : `${tytul} | PHU Probud`;
const adres = new URL(Astro.url.pathname, Astro.site);
const obraz = new URL(obrazOg, Astro.site).href;

// Dane strukturalne firmy: te same fakty, co w sekcji Kontakt i w wizytowce Google.
// Godzin otwarcia nie podajemy, bo nie mamy ich ze zrodla.
const bezSpacji = (numer: string) => numer.replace(/\s/g, '');
const idFirmy = new URL('/#firma', Astro.site).href;
const daneFirmy = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': idFirmy,
      name: firma.nazwa,
      legalName: firma.nazwaPrawna,
      url: new URL('/', Astro.site).href,
      image: obraz,
      logo: new URL('/marka/probud-logo-ciemne.webp', Astro.site).href,
      description: opis,
      foundingDate: String(firma.od),
      taxID: firma.nip,
      telephone: bezSpacji(dzialy[0].telefony[0].numer),
      email: dzialy[0].email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: firma.adres.ulica,
        postalCode: firma.adres.kod,
        addressLocality: firma.adres.miasto,
        addressRegion: 'wielkopolskie',
        addressCountry: 'PL',
      },
      geo: { '@type': 'GeoCoordinates', latitude: firma.wspolrzedne.lat, longitude: firma.wspolrzedne.lng },
      contactPoint: dzialy.map((d) => ({
        '@type': 'ContactPoint',
        contactType: d.nazwa,
        telephone: bezSpacji(d.telefony[0].numer),
        email: d.email,
        availableLanguage: 'pl',
      })),
      sameAs: [firma.facebook, firma.instagram, firma.otomoto],
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#strona', Astro.site).href,
      url: new URL('/', Astro.site).href,
      name: firma.nazwa,
      inLanguage: 'pl-PL',
      publisher: { '@id': idFirmy },
    },
  ],
};
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pelnyTytul}</title>
    <meta name="description" content={opis} />
    <!-- Adres demonstracyjny jest poza wyszukiwarkami przez naglowek X-Robots-Tag (nginx.conf),
         wiec na domenie docelowej strona indeksuje sie bez zmian w szablonie. -->
    {bezIndeksu
      ? <meta name="robots" content="noindex" />
      : <link rel="canonical" href={adres.href} />}
    <meta name="theme-color" content="#881810" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={fontNaglowki} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontNaglowkiExt} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontTekst} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={pelnyTytul} />
    <meta property="og:description" content={opis} />
    <meta property="og:image" content={obraz} />
    <meta property="og:url" content={adres.href} />
    <meta property="og:site_name" content={firma.nazwa} />
    <meta name="twitter:card" content="summary_large_image" />
    {glowna && <script type="application/ld+json" is:inline set:html={JSON.stringify(daneFirmy)} />}
    <slot name="glowa" />
  </head>
  <body>
    <a class="przeskocz" href="#tresc">Przejdź do treści</a>
    <Ogloszenie />
    <Naglowek />
    <main id="tresc">
      <slot />
    </main>
    <Stopka />
    <PasekTelefonu />
  </body>
</html>

<style>
  .przeskocz {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--grafit);
    color: var(--papier);
    font-weight: 650;
  }
  .przeskocz:focus { top: 1rem; }
</style>
