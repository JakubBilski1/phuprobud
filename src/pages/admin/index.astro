---
// Panel strony: edycja oferty, tekstow, zdjec, ludzi i kontaktu. Logowanie i zapis ida przez
// API serwera (src/pages/api/panel/), zmiany leza w bazie i serwer renderuje z nimi strone.
// Sama strona panelu jest budowana statycznie z tresci z repozytorium: wartosci w polach to
// oryginaly, a zapisane zmiany skrypt dociaga z serwera po zalogowaniu.
import '@fontsource-variable/big-shoulders/opsz.css';
import '@fontsource-variable/sofia-sans/index.css';
import '../../styles/global.css';
import Foto from '../../components/Foto.astro';
import Pole from '../../components/panel/Pole.astro';
import Przelacznik from '../../components/panel/Przelacznik.astro';
import { WSZYSTKIE_KATEGORIE as kategorie, WSZYSTKIE_MODELE as modele } from '../../data/katalog';
import { tresci, grupyTresci, type KluczTresci } from '../../data/tresci';
import { zespol, dzialy, finansowanie } from '../../data/firma';
import { REALIZACJE as realizacje } from '../../data/realizacje';
import { slotyZdjec } from '../../data/zdjecia-strony';
import manifest from '../../data/obrazy.json';
import { odmiana } from '../../lib/tekst';
import { MIN_DLUGOSC_HASLA } from '../../lib/nadpisania';

export const prerender = true;

const polaTresci = Object.entries(tresci) as [KluczTresci, (typeof tresci)[KluczTresci]][];
const MODEL: [string, string, string] = ['model', 'modele', 'modeli'];
const osoby = zespol;
const imie = (o: { imie: string; nazwisko: string }) => `${o.imie} ${o.nazwisko}`;
const szukaj = (s: string) => s.toLowerCase().normalize('NFD').replace(/[^a-z0-9]/g, '');

// Zdjecia strony dla zakladek „Galeria realizacji” i „Zdjecia na stronie”: oryginalny uklad galerii
// (wartosc domyslna pola) i miniatury do podgladu w edytorze (src/scripts/panel-zdjecia.ts).
type WpisObrazu = { warianty: { w: number; src: string }[] };
const obraz = (k: string) => (manifest as Record<string, WpisObrazu>)[k].warianty;
const zdjeciaStrony = Object.fromEntries(realizacje.map((r) => [r.plik, {
  podpis: r.podpis,
  mini: obraz(r.plik)[0].src,
  sredni: (obraz(r.plik).find((v) => v.w >= 700) ?? obraz(r.plik).at(-1)!).src,
}]));
const galeriaOryginal = JSON.stringify(realizacje.map((r) => ({ z: r.plik, p: r.podpis })));
const ZDJEC: [string, string, string] = ['zdjęcie', 'zdjęcia', 'zdjęć'];

const sekcje = [
  { id: 'pulpit', nazwa: 'Pulpit' },
  { id: 'oferta', nazwa: 'Oferta i maszyny' },
  { id: 'teksty', nazwa: 'Teksty strony' },
  { id: 'galeria', nazwa: 'Galeria realizacji' },
  { id: 'zdjecia', nazwa: 'Zdjęcia na stronie' },
  { id: 'kontakt', nazwa: 'Ludzie i kontakt' },
  { id: 'ogloszenie', nazwa: 'Ogłoszenie' },
  { id: 'konto', nazwa: 'Konto i hasło' },
];
const ETYKIETY = ['Nowość', 'Promocja', 'Dostępny od ręki', 'Ostatnie sztuki', 'Na zamówienie'];
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel strony | PHU Probud</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#222222" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
  </head>
  <body class="panel-strona">
    <!-- Logowanie -->
    <!-- Ukryte do czasu, az skrypt sprawdzi sesje: zalogowana osoba nie widzi mrugniecia formularza. -->
    <div class="logowanie" data-logowanie hidden>
      <form class="logowanie__karta" data-form-logowania novalidate>
        <img class="logowanie__logo" src="/marka/probud-logo-ciemne.webp" alt="PHU Probud" width="489" height="98" />
        <h1>Panel strony</h1>
        <p class="logowanie__wstep">Zaloguj się, żeby zmienić ofertę, teksty i dane kontaktowe na stronie.</p>
        <div class="pole">
          <label for="l-login">E-mail</label>
          <input id="l-login" name="login" type="email" autocomplete="username" inputmode="email" required />
        </div>
        <div class="pole">
          <label for="l-haslo">Hasło</label>
          <input id="l-haslo" name="haslo" type="password" autocomplete="current-password" required />
        </div>
        <p class="logowanie__blad" data-blad-logowania role="alert" hidden></p>
        <button class="przycisk logowanie__przycisk" type="submit" data-przycisk-logowania>Zaloguj się</button>
      </form>
      <!-- Drugi krok: kod z e-maila, obowiazkowy przy kazdym logowaniu. -->
      <form class="logowanie__karta" data-form-kodu novalidate hidden>
        <img class="logowanie__logo" src="/marka/probud-logo-ciemne.webp" alt="PHU Probud" width="489" height="98" />
        <h1>Kod z e-maila</h1>
        <p class="logowanie__wstep" data-opis-kodu>Wysłaliśmy 6-cyfrowy kod na Twój e-mail.</p>
        <div class="pole">
          <label for="l-kod">Kod</label>
          <input id="l-kod" name="kod" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />
        </div>
        <p class="logowanie__blad" data-blad-kodu role="alert" hidden></p>
        <p class="logowanie__info" data-info-kodu role="status" hidden></p>
        <button class="przycisk logowanie__przycisk" type="submit" data-przycisk-kodu>Potwierdź</button>
        <div class="logowanie__akcje">
          <button type="button" class="logowanie__link" data-nowy-kod>Wyślij nowy kod</button>
          <button type="button" class="logowanie__link" data-wroc-do-hasla>Wróć</button>
        </div>
      </form>
      <a class="logowanie__powrot" href="/">Wróć na stronę</a>
    </div>

    <!-- Panel -->
    <div class="panel" data-panel hidden>
      <header class="panel__gora">
        <a class="panel__marka" href="#pulpit">
          <img src="/marka/probud-logo-jasne.webp" alt="PHU Probud" width="489" height="98" />
          <span>Panel strony</span>
        </a>
        <div class="panel__konto">
          <a href="/" target="_blank" rel="noopener">Zobacz stronę</a>
          <span class="panel__uzytkownik" data-uzytkownik>admin</span>
          <button type="button" data-wyloguj>Wyloguj</button>
        </div>
      </header>

      <nav class="panel__menu" aria-label="Sekcje panelu">
        <ul role="list">
          {sekcje.map((s) => (
            <li><a href={`#${s.id}`} data-link-sekcji={s.id}>{s.nazwa}<span class="znaczek" data-znaczek={s.id} hidden></span></a></li>
          ))}
        </ul>
      </nav>

      <main class="panel__tresc">
        <!-- Pulpit -->
        <section class="sekcja-panelu" data-sekcja="pulpit" aria-labelledby="s-pulpit">
          <div class="sekcja-panelu__glowa">
            <h1 id="s-pulpit">Pulpit</h1>
            <p>Stan strony po zapisanych zmianach. <span data-ostatni-zapis></span></p>
          </div>

          <ul class="liczniki" role="list">
            <li><span>Modele w ofercie</span><strong data-stat="modele">{modele.length}</strong><small>z {modele.length}</small></li>
            <li><span>Grupy w ofercie</span><strong data-stat="grupy">{kategorie.length}</strong><small>z {kategorie.length}</small></li>
            <li><span>Zmienione pola</span><strong data-stat="zmiany">0</strong><small>względem oryginału</small></li>
            <li><span>Ogłoszenie</span><strong data-stat="ogloszenie">wyłączone</strong><small>pasek na górze strony</small></li>
          </ul>

          <div class="karta-panelu">
            <div class="karta-panelu__glowa">
              <h2>Zapisane zmiany</h2>
              <button type="button" class="przycisk-maly przycisk-maly--ostrzezenie" data-przywroc-wszystko hidden>Przywróć całą stronę do oryginału</button>
            </div>
            <ul class="zmiany" role="list" data-lista-zmian></ul>
            <p class="pusto" data-brak-zmian>Brak zmian. Strona wygląda jak oryginał.</p>
            <template data-szablon-zmiany>
              <li class="zmiana">
                <div>
                  <p class="zmiana__co" data-co></p>
                  <p class="zmiana__roznica"><del data-bylo></del> <span aria-hidden="true">→</span> <ins data-jest></ins></p>
                </div>
                <div class="zmiana__akcje">
                  <button type="button" class="przycisk-maly" data-edytuj>Edytuj</button>
                  <button type="button" class="przycisk-maly" data-cofnij>Cofnij</button>
                </div>
              </li>
            </template>
          </div>

          <div class="skroty">
            <a class="skrot" href="#oferta"><strong>Oferta i maszyny</strong><span>Widoczność {odmiana(modele.length, MODEL)} i {kategorie.length} grup, opisy, etykiety i ceny.</span></a>
            <a class="skrot" href="#teksty"><strong>Teksty strony</strong><span>{polaTresci.length} tekstów: nagłówki, opisy sekcji, przyciski.</span></a>
            <a class="skrot" href="#galeria"><strong>Galeria realizacji</strong><span>{odmiana(realizacje.length, ZDJEC)}: kolejność, podpisy, podmiana i nowe zdjęcia.</span></a>
            <a class="skrot" href="#zdjecia"><strong>Zdjęcia na stronie</strong><span>Zdjęcia w sekcji „Maszyny używane”: z galerii albo z dysku.</span></a>
            <a class="skrot" href="#kontakt"><strong>Ludzie i kontakt</strong><span>Osoby, role, numery telefonów i adresy e-mail działów.</span></a>
            <a class="skrot" href="#ogloszenie"><strong>Ogłoszenie</strong><span>Pasek z komunikatem na górze każdej strony.</span></a>
          </div>

          <div class="zacheta-hasla" data-tylko-start>
            <div>
              <strong>Ustaw własne hasło</strong>
              <p>Panel działa jeszcze na haśle startowym, które zna też opiekun strony. Dopóki nie ustawisz własnego, zmiany na stronie się nie zapiszą.</p>
            </div>
            <a class="przycisk przycisk--jasny" href="#konto">Zmień hasło</a>
          </div>

          <p class="uwaga-panelu">Zapisane zmiany są od razu widoczne na stronie dla wszystkich odwiedzających. Każdą zmianę można cofnąć na liście powyżej; „oryginał” to treść, z którą strona została uruchomiona.</p>
        </section>

        <!-- Oferta -->
        <section class="sekcja-panelu" data-sekcja="oferta" aria-labelledby="s-oferta" hidden>
          <div class="sekcja-panelu__glowa">
            <h1 id="s-oferta">Oferta i maszyny</h1>
            <p>Ukryty model znika z katalogu, ze strony grupy i z porównań. Ukryta grupa znika z oferty na stronie głównej, z katalogu i ze stopki. Etykieta i cena pokazują się na karcie modelu i na jego podstronie.</p>
          </div>

          <div class="narzedzia">
            <div class="pole">
              <label for="szukaj-modelu">Szukaj modelu</label>
              <input id="szukaj-modelu" type="search" placeholder="np. BW 120, BPR, RT135" data-szukaj-modelu autocomplete="off" />
            </div>
            <div class="pole">
              <label for="filtr-modeli">Pokaż</label>
              <select id="filtr-modeli" data-filtr-modeli>
                <option value="wszystkie">Wszystkie modele</option>
                <option value="widoczne">Widoczne w ofercie</option>
                <option value="ukryte">Ukryte</option>
                <option value="zmienione">Zmienione</option>
              </select>
            </div>
          </div>
          <p class="pusto" data-brak-modeli hidden>Żaden model nie pasuje do wyszukiwania.</p>

          <datalist id="etykiety-modeli">
            {ETYKIETY.map((e) => <option value={e} />)}
          </datalist>

          {kategorie.map((k) => (
            <section class="grupa-panelu" data-grupa={k.id} aria-labelledby={`g-${k.id}`}>
              <div class="grupa-panelu__glowa">
                <span class="grupa-panelu__picto" style={`--maska:url(/piktogramy/${k.piktogram}.png)`} aria-hidden="true"></span>
                <div class="grupa-panelu__tytul">
                  <h2 id={`g-${k.id}`} data-nazwa-grupy={k.id}>{k.nazwa}</h2>
                  <p><span data-licznik-grupy={k.id}>{k.modele.length} z {k.modele.length}</span> w ofercie · {k.marka} · <a href={k.href} target="_blank" rel="noopener">strona grupy</a></p>
                </div>
                <Przelacznik klucz={`kategoria:${k.id}:widoczna`} etykieta="Grupa w ofercie" sciezka={`Grupa ${k.nazwa} · widoczność`} zaznaczony tak="widoczna" nie="ukryta" />
                <button type="button" class="przycisk-maly" aria-expanded="false" aria-controls={`o-${k.id}`} data-rozwin>Nazwa i opis grupy</button>
              </div>
              <div class="grupa-panelu__opis" id={`o-${k.id}`} hidden>
                <Pole klucz={`kategoria:${k.id}:nazwa`} etykieta="Nazwa grupy" sciezka={`Grupa ${k.nazwa} · nazwa`} wartosc={k.nazwa} wymagane max={50} />
                <Pole klucz={`kategoria:${k.id}:opis`} etykieta="Opis grupy" sciezka={`Grupa ${k.nazwa} · opis`} wartosc={k.opis} typ="dlugi" wymagane max={400} />
              </div>

              <ul class="modele-panelu" role="list">
                {k.modele.map((m) => (
                  <li class="model-panelu" data-wiersz-modelu={m.id} data-szukaj={szukaj(`${m.nazwa} ${m.marka}`)}>
                    <div class="model-panelu__foto"><Foto nazwa={m.zdjecie} alt="" sizes="88px" /></div>
                    <div class="model-panelu__nazwa">
                      <h3>{m.nazwa}</h3>
                      <p>{m.masa !== null ? `${m.parametry.find((p) => p.klucz === 'masa_robocza_kg')?.wartosc}` : 'masa: brak danych'} · <a href={m.href} target="_blank" rel="noopener">podstrona</a></p>
                    </div>
                    <Pole klucz={`model:${m.id}:etykieta`} etykieta="Etykieta" sciezka={`${m.nazwa} · etykieta`} wartosc="" lista="etykiety-modeli" placeholder="brak" max={24} bezPrzywracania />
                    <Pole klucz={`model:${m.id}:cena`} etykieta="Cena" sciezka={`${m.nazwa} · cena`} wartosc="" placeholder="np. od 12 900 zł netto" max={40} bezPrzywracania />
                    <Przelacznik klucz={`model:${m.id}:widoczny`} etykieta="W ofercie" sciezka={`${m.nazwa} · widoczność`} zaznaczony tak="widoczny" nie="ukryty" />
                    <div class="model-panelu__akcje">
                      <button type="button" class="przycisk-maly" aria-expanded="false" aria-controls={`opis-${m.id}`} data-rozwin>Opis</button>
                      <button type="button" class="przycisk-maly" data-przywroc-wiersz hidden>Przywróć</button>
                    </div>
                    <div class="model-panelu__opis" id={`opis-${m.id}`} hidden>
                      <Pole klucz={`model:${m.id}:opis`} etykieta={`Opis ${m.kod} (podstrona modelu)`} sciezka={`${m.nazwa} · opis`} wartosc={m.opis} typ="dlugi" wymagane max={400} bezPrzywracania />
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </section>

        <!-- Teksty -->
        <section class="sekcja-panelu" data-sekcja="teksty" aria-labelledby="s-teksty" hidden>
          <div class="sekcja-panelu__glowa">
            <h1 id="s-teksty">Teksty strony</h1>
            <p>Nagłówki i opisy sekcji w kolejności, w jakiej są na stronie. Spójniki na końcu wiersza i liczby z jednostkami strona układa sama.</p>
          </div>
          {grupyTresci.map((g) => {
            const pola = polaTresci.filter(([, p]) => p.grupa === g);
            return (
              <section class="karta-panelu">
                <div class="karta-panelu__glowa">
                  <h2>{g}</h2>
                  <a class="przycisk-maly" href={pola[0][1].gdzie} target="_blank" rel="noopener">Pokaż na stronie</a>
                </div>
                <div class="siatka-pol">
                  {pola.map(([klucz, p]) => (
                    <Pole klucz={`tekst:${klucz}`} etykieta={p.etykieta} sciezka={`${p.grupa} · ${p.etykieta.toLowerCase()}`} wartosc={p.wartosc} typ={p.dlugi ? 'dlugi' : 'tekst'} wymagane max={p.max ?? 400} />
                  ))}
                </div>
              </section>
            );
          })}
        </section>

        <!-- Galeria realizacji -->
        <section class="sekcja-panelu" data-sekcja="galeria" aria-labelledby="s-galeria" hidden>
          <div class="sekcja-panelu__glowa">
            <h1 id="s-galeria">Galeria realizacji</h1>
            <p>Zdjęcia w galerii „Realizacje” na stronie głównej, w tej kolejności. Pierwsze na liście pokazuje się jako pierwsze. Kolejność zmienisz strzałkami albo przeciągając wiersz za uchwyt.</p>
          </div>
          <div class="karta-panelu" data-pole-ramka>
            <input type="text" hidden tabindex="-1" aria-hidden="true" data-pole="galeria:uklad" data-etykieta="Galeria realizacji" data-typ="galeria" value={galeriaOryginal} />
            <div class="karta-panelu__glowa">
              <h2><span data-galeria-licznik>{odmiana(realizacje.length, ZDJEC)}</span> w galerii</h2>
              <div class="karta-panelu__akcje">
                <button type="button" class="pole__przywroc" data-przywroc="galeria:uklad" hidden>Przywróć oryginał</button>
                <label class="przycisk-maly przycisk-plik">Dodaj zdjęcia z dysku<input type="file" accept="image/*" multiple class="sr-only" data-galeria-dodaj /></label>
              </div>
            </div>
            <p class="pole__blad" data-galeria-blad role="alert" hidden></p>
            <ol class="galeria-panelu" role="list" data-galeria-lista></ol>
            <div class="galeria-panelu__usuniete" data-galeria-usuniete-ramka hidden>
              <h3>Usunięte z galerii</h3>
              <ul class="galeria-panelu" role="list" data-galeria-usuniete></ul>
            </div>
            <p class="pole__podpowiedz">Nowe zdjęcia panel zmniejsza do 2000 px na dłuższym boku. Na stronie pojawiają się po zapisaniu zmian.</p>
          </div>
          <template data-szablon-galerii>
            <li class="poz-galerii">
              <span class="poz-galerii__uchwyt" aria-hidden="true" title="Przeciągnij, żeby zmienić kolejność" data-uchwyt></span>
              <span class="poz-galerii__nr" data-nr></span>
              <img class="poz-galerii__foto" alt="" width="120" height="80" data-foto />
              <div class="pole poz-galerii__podpis">
                <label data-etykieta-podpisu>Podpis <span class="poz-galerii__nowe" data-znacznik-nowe hidden>z dysku</span></label>
                <input type="text" maxlength="80" placeholder="np. Koparka kołowa Atlas" data-podpis />
              </div>
              <div class="poz-galerii__akcje">
                <button type="button" class="przycisk-maly" data-w-gore aria-label="Przesuń wyżej">↑</button>
                <button type="button" class="przycisk-maly" data-w-dol aria-label="Przesuń niżej">↓</button>
                <label class="przycisk-maly przycisk-plik">Podmień<input type="file" accept="image/*" class="sr-only" data-podmien /></label>
                <button type="button" class="przycisk-maly przycisk-maly--ostrzezenie" data-usun>Usuń</button>
              </div>
            </li>
          </template>
          <template data-szablon-usunietego>
            <li class="poz-galerii poz-galerii--usunieta">
              <img class="poz-galerii__foto" alt="" width="120" height="80" data-foto />
              <p class="poz-galerii__nazwa" data-nazwa></p>
              <button type="button" class="przycisk-maly" data-przywroc-zdjecie>Przywróć do galerii</button>
            </li>
          </template>
        </section>

        <!-- Zdjecia na stronie -->
        <section class="sekcja-panelu" data-sekcja="zdjecia" aria-labelledby="s-zdjecia" hidden>
          <div class="sekcja-panelu__glowa">
            <h1 id="s-zdjecia">Zdjęcia na stronie</h1>
            <p>Zdjęcia, które pokazują się przed galerią. Możesz wybrać jedno ze zdjęć galerii albo wgrać nowe z dysku.</p>
          </div>
          {slotyZdjec.map((s) => (
            <section class="karta-panelu slot-zdjecia" data-pole-ramka data-slot={s.id} data-oryginal={s.plik} aria-labelledby={`slot-${s.id}`}>
              <input type="text" hidden tabindex="-1" aria-hidden="true" data-pole={`zdjecie:${s.id}`} data-etykieta={s.nazwa} data-typ="zdjecie" value="" />
              <div class="karta-panelu__glowa">
                <h2 id={`slot-${s.id}`}>{s.nazwa}</h2>
                <button type="button" class="pole__przywroc" data-przywroc={`zdjecie:${s.id}`} hidden>Przywróć oryginał</button>
              </div>
              <div class="slot-zdjecia__uklad">
                <img class="slot-zdjecia__podglad" alt="" style={`aspect-ratio:${s.proporcje}`} data-slot-podglad />
                <div class="slot-zdjecia__akcje">
                  <p class="slot-zdjecia__stan" data-slot-opis></p>
                  <div class="pole">
                    <label for={`slot-wybor-${s.id}`}>Wybierz z galerii</label>
                    <select id={`slot-wybor-${s.id}`} data-slot-wybor>
                      <option value="">Oryginał: {zdjeciaStrony[s.plik]?.podpis}</option>
                      <option value="dysk" hidden>Zdjęcie wgrane z dysku</option>
                      {realizacje.map((r) => <option value={`plik:${r.plik}`}>{r.podpis}</option>)}
                    </select>
                  </div>
                  <label class="przycisk-maly przycisk-plik">Wgraj z dysku<input type="file" accept="image/*" class="sr-only" data-slot-plik /></label>
                  <p class="pole__blad" data-slot-blad role="alert" hidden></p>
                  <p class="pole__podpowiedz">Ramka na stronie ma proporcje {s.proporcje.replace(' / ', ':')}: zdjęcie zostanie w nią wpasowane i przycięte.</p>
                </div>
              </div>
            </section>
          ))}
        </section>

        <!-- Ludzie i kontakt -->
        <section class="sekcja-panelu" data-sekcja="kontakt" aria-labelledby="s-kontakt" hidden>
          <div class="sekcja-panelu__glowa">
            <h1 id="s-kontakt">Ludzie i kontakt</h1>
            <p>Nowy numer albo adres zastępuje stary wszędzie: w sekcji „Z kim rozmawiasz”, w nagłówku, w pasku na telefonie, w katalogu, w kontakcie i w formularzu.</p>
          </div>

          <div class="osoby-panelu">
            {osoby.map((o) => (
              <section class="karta-panelu">
                <h2>{o.rola}</h2>
                <Pole klucz={`osoba:${o.id}:imie`} etykieta="Imię i nazwisko" sciezka={`${imie(o)} · imię i nazwisko`} wartosc={imie(o)} wymagane max={60} />
                <Pole klucz={`osoba:${o.id}:rola`} etykieta="Rola" sciezka={`${imie(o)} · rola`} wartosc={o.rola} wymagane max={40} />
                {o.telefon && <Pole klucz={`osoba:${o.id}:telefon`} etykieta="Telefon" sciezka={`${imie(o)} · telefon`} wartosc={o.telefon} typ="telefon" wymagane max={20} />}
              </section>
            ))}
          </div>

          <section class="karta-panelu">
            <h2>Działy</h2>
            <div class="siatka-pol">
              {dzialy.map((d) => (
                <>
                  {d.telefony.filter((t) => !t.osobaId).map((t) => (
                    <Pole klucz={`dzial:${d.id}:telefon`} etykieta={`${d.nazwa}: telefon`} sciezka={`Dział ${d.nazwa.toLowerCase()} · telefon`} wartosc={t.numer} typ="telefon" wymagane max={20} />
                  ))}
                  <Pole klucz={`dzial:${d.id}:email`} etykieta={`${d.nazwa}: e-mail`} sciezka={`Dział ${d.nazwa.toLowerCase()} · e-mail`} wartosc={d.email} typ="email" wymagane max={80} />
                </>
              ))}
            </div>
            <p class="pole__podpowiedz">Telefony działu sprzedaży i działu części to numery osób powyżej.</p>
          </section>

          <section class="karta-panelu">
            <h2>Finansowanie</h2>
            <div class="siatka-pol">
              <Pole klucz="finansowanie:osoba" etykieta="Opiekun finansowania" sciezka="Finansowanie · opiekun" wartosc={finansowanie.osoba} wymagane max={60} />
              <Pole klucz="finansowanie:telefon" etykieta="Telefon" sciezka="Finansowanie · telefon" wartosc={finansowanie.telefon} typ="telefon" wymagane max={20} />
              <Pole klucz="finansowanie:email" etykieta="E-mail" sciezka="Finansowanie · e-mail" wartosc={finansowanie.email} typ="email" wymagane max={80} />
            </div>
          </section>
        </section>

        <!-- Ogloszenie -->
        <section class="sekcja-panelu" data-sekcja="ogloszenie" aria-labelledby="s-ogloszenie" hidden>
          <div class="sekcja-panelu__glowa">
            <h1 id="s-ogloszenie">Ogłoszenie</h1>
            <p>Pasek nad nagłówkiem, na każdej stronie. Do krótkich komunikatów: godziny otwarcia w święta, dostawa nowych maszyn, targi.</p>
          </div>
          <div class="karta-panelu">
            <Przelacznik klucz="ogloszenie:wlaczone" etykieta="Pokaż ogłoszenie na stronie" sciezka="Ogłoszenie · widoczność" zaznaczony={false} />
            <Pole klucz="ogloszenie:tekst" etykieta="Treść" sciezka="Ogłoszenie · treść" wartosc="" typ="dlugi" max={160} placeholder="np. 24 i 31 grudnia pracujemy do 12:00." />
            <Pole klucz="ogloszenie:link" etykieta="Link (opcjonalnie)" sciezka="Ogłoszenie · link" wartosc="" typ="link" max={200} placeholder="np. /oferta/walce-tandemowe/" podpowiedz="Adres na tej stronie zaczyna się od /, adres innej strony od https://." />
            <div class="podglad-ogloszenia">
              <p class="pole__podpowiedz">Podgląd</p>
              <div class="podglad-ogloszenia__pasek" data-podglad-ogloszenia><span data-podglad-tekst>Wpisz treść ogłoszenia.</span> <u data-podglad-link hidden>Szczegóły</u></div>
            </div>
          </div>
        </section>
        <!-- Konto i haslo -->
        <section class="sekcja-panelu" data-sekcja="konto" aria-labelledby="s-konto" hidden>
          <div class="sekcja-panelu__glowa">
            <h1 id="s-konto">Konto i hasło</h1>
            <p data-konto-stan></p>
          </div>
          <form class="karta-panelu konto-panelu" data-form-hasla novalidate>
            <h2>Zmiana hasła</h2>
            <input type="text" name="login" value="" autocomplete="username" hidden tabindex="-1" aria-hidden="true" data-login-konta />
            <div class="pole">
              <label for="h-obecne">Obecne hasło</label>
              <input id="h-obecne" name="obecne" type="password" autocomplete="current-password" />
            </div>
            <div class="pole">
              <label for="h-nowe">Nowe hasło</label>
              <input id="h-nowe" name="nowe" type="password" autocomplete="new-password" aria-describedby="h-nowe-opis" />
              <p class="pole__podpowiedz" id="h-nowe-opis">Co najmniej {MIN_DLUGOSC_HASLA} znaków.</p>
            </div>
            <div class="pole">
              <label for="h-powtorz">Powtórz nowe hasło</label>
              <input id="h-powtorz" name="powtorz" type="password" autocomplete="new-password" />
            </div>
            <p class="konto-panelu__blad" data-blad-hasla role="alert" hidden></p>
            <p class="konto-panelu__ok" data-ok-hasla role="status" hidden></p>
            <button class="przycisk" type="submit" data-przycisk-hasla>Zmień hasło</button>
          </form>
          <p class="uwaga-panelu">Hasło sprawdza serwer; w bazie leży tylko jego skrót. Każde logowanie wymaga też kodu z e-maila. Po zmianie hasła panel wylogowuje wszystkie inne urządzenia.</p>
        </section>
      </main>

      <div class="zapis" data-pasek-zapisu hidden>
        <p data-licznik-zmian></p>
        <div>
          <button type="button" class="przycisk przycisk--obrys-jasny" data-odrzuc>Odrzuć</button>
          <button type="button" class="przycisk przycisk--jasny" data-zapisz>Zapisz zmiany</button>
        </div>
      </div>
      <div class="komunikat" data-komunikat role="status" aria-live="polite" hidden></div>
    </div>

    <script type="application/json" data-zdjecia-strony set:html={JSON.stringify(zdjeciaStrony)} />
    <script>
      import { uruchomPanel } from '../../scripts/panel';
      import { uruchomZdjeciaPanelu } from '../../scripts/panel-zdjecia';
      // Najpierw edytory zdjec: panel przy starcie ustawia zapisane wartosci i powiadamia o tym pola.
      uruchomZdjeciaPanelu();
      void uruchomPanel();
    </script>
  </body>
</html>

<style is:global>
  .panel-strona { background: var(--beton); min-height: 100vh; }
  .panel-strona [hidden] { display: none !important; }

  /* Pola formularzy wspolne dla logowania i panelu */
  .panel-strona .pole { display: grid; gap: 0.35rem; min-width: 0; }
  .panel-strona .pole__glowa { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; }
  .panel-strona label { font-weight: 650; font-size: 0.95rem; }
  .panel-strona input:not([type='checkbox']), .panel-strona textarea, .panel-strona select {
    width: 100%;
    padding: 0.65rem 0.8rem;
    background: var(--papier);
    border: 1px solid #b9b9b1;
    border-radius: 0;
    font-size: 1rem;
    line-height: 1.4;
  }
  .panel-strona textarea { resize: vertical; min-height: 5.5rem; }
  .panel-strona input:focus-visible, .panel-strona textarea:focus-visible, .panel-strona select:focus-visible { outline: 3px solid var(--zolty); outline-offset: 0; box-shadow: none; border-color: var(--grafit); }
  .panel-strona .pole.zmienione input, .panel-strona .pole.zmienione textarea { border-color: var(--grafit); box-shadow: inset 4px 0 0 var(--zolty-ciemny); }
  .panel-strona [aria-invalid='true'] { border-color: var(--probud) !important; box-shadow: inset 4px 0 0 var(--probud) !important; }
  .pole__przywroc { font-size: var(--t-maly); font-weight: 650; text-decoration: underline; text-underline-offset: 0.18em; color: var(--probud); }
  .pole__podpowiedz { font-size: var(--t-maly); color: var(--stal); }
  .pole__blad { font-size: var(--t-maly); font-weight: 650; color: var(--probud); }

  .przycisk-maly {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--grafit);
    background: var(--papier);
    font-size: var(--t-maly);
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }
  .przycisk-maly:hover { background: var(--grafit); color: var(--papier); }
  .przycisk-maly[aria-expanded='true'] { background: var(--grafit); color: var(--papier); }
  .przycisk-maly--ostrzezenie { border-color: var(--probud); color: var(--probud); }
  .przycisk-maly--ostrzezenie:hover { background: var(--probud); color: var(--papier); }

  /* Przelacznik */
  .przelacznik { display: inline-flex; align-items: center; gap: 0.6rem; cursor: pointer; font-weight: 650; font-size: 0.95rem; }
  .przelacznik input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .przelacznik__tor { position: relative; flex: none; width: 2.75rem; height: 1.5rem; background: #b9b9b1; border-radius: 1rem; transition: background-color var(--ruch-szybki); }
  .przelacznik__tor::after { content: ''; position: absolute; top: 3px; left: 3px; width: calc(1.5rem - 6px); height: calc(1.5rem - 6px); background: var(--papier); border-radius: 50%; transition: transform var(--ruch-szybki) var(--ruch-wyjscie); }
  .przelacznik input:checked + .przelacznik__tor { background: var(--grafit); }
  .przelacznik input:checked + .przelacznik__tor::after { transform: translateX(1.25rem); background: var(--zolty); }
  .przelacznik input:focus-visible + .przelacznik__tor { outline: 3px solid var(--zolty); outline-offset: 2px; box-shadow: 0 0 0 5px var(--grafit); }

  /* Logowanie */
  .logowanie { min-height: 100vh; display: grid; place-content: center; justify-items: center; gap: 1.25rem; padding: 2rem 1rem; background: var(--grafit); }
  .logowanie__karta { display: grid; gap: 1rem; width: min(26rem, 100%); padding: clamp(1.5rem, 5vw, 2.5rem); background: var(--papier); border-radius: 0 0 0 var(--rog); border-top: 6px solid var(--zolty); }
  .logowanie__logo { width: 9.5rem; height: auto; }
  .logowanie h1 { font-size: clamp(2.4rem, 6vw, 3.2rem); margin-top: 0.5rem; }
  .logowanie__wstep { color: var(--stal); }
  .logowanie__blad { padding: 0.6rem 0.8rem; background: #f7e3e1; color: var(--probud); font-weight: 650; }
  .logowanie__przycisk { justify-content: center; width: 100%; margin-top: 0.25rem; }
  .logowanie__przycisk[disabled] { opacity: 0.75; cursor: progress; }
  .logowanie__powrot { color: var(--papier); font-weight: 600; }
  .logowanie__info { padding: 0.6rem 0.8rem; background: var(--beton); color: var(--grafit); font-weight: 600; }
  .logowanie__akcje { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1rem; }
  .logowanie__link { padding: 0.25rem 0; border: 0; background: none; color: var(--probud); font: inherit; font-weight: 650; text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer; }
  .logowanie__link[disabled] { color: var(--stal); cursor: progress; }
  #l-kod { font-size: 1.6rem; letter-spacing: 0.4em; font-variant-numeric: tabular-nums; }

  /* Uklad panelu */
  /* --gora: wysokosc gornego paska; na niej opieraja sie przyklejone menu i wyszukiwarka. */
  .panel { --gora: 3.5rem; display: grid; grid-template-columns: 15rem minmax(0, 1fr); grid-template-rows: auto 1fr; min-height: 100vh; }
  .panel__gora { grid-column: 1 / -1; position: sticky; top: 0; z-index: 20; display: flex; justify-content: space-between; align-items: center; gap: 1rem; height: var(--gora); padding: 0 clamp(1rem, 3vw, 1.75rem); background: var(--grafit); color: var(--papier); }
  .panel__marka { display: flex; align-items: center; gap: 1rem; color: inherit; text-decoration: none; }
  .panel__marka img { width: 7.5rem; height: auto; }
  .panel__marka span { font-family: var(--kroj-naglowki); font-weight: 800; font-size: 1.5rem; line-height: 1; padding-left: 1rem; border-left: 1px solid #ffffff40; }
  .panel__konto { display: flex; align-items: center; gap: 1.25rem; font-size: 0.95rem; font-weight: 600; }
  .panel__konto a, .panel__konto button { color: inherit; text-decoration: underline; text-underline-offset: 0.2em; }
  .panel__uzytkownik { padding: 0.2rem 0.6rem; background: #ffffff1a; }

  .panel__menu { background: var(--papier); border-right: 1px solid var(--linia); }
  .panel__menu ul { position: sticky; top: var(--gora); display: grid; padding: 1rem 0; }
  .panel__menu a { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; padding: 0.8rem 1.25rem; font-weight: 650; text-decoration: none; border-left: 4px solid transparent; }
  .panel__menu a:hover { background: var(--beton); }
  .panel__menu a[aria-current='page'] { border-left-color: var(--zolty); background: var(--beton); }
  .znaczek { min-width: 1.6rem; padding: 0.1rem 0.45rem; background: var(--zolty); font-size: 0.8rem; font-weight: 800; text-align: center; }

  .panel__tresc { padding: clamp(1.25rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2.5rem) 8rem; }
  .sekcja-panelu { display: grid; gap: 1.25rem; max-width: 72rem; }
  .sekcja-panelu__glowa { display: grid; gap: 0.5rem; margin-bottom: 0.5rem; }
  .sekcja-panelu__glowa h1 { font-size: clamp(2.4rem, 4.5vw, 3.6rem); }
  .sekcja-panelu__glowa p { color: var(--stal); }

  .karta-panelu { display: grid; gap: 1rem; padding: clamp(1rem, 2.5vw, 1.5rem); min-width: 0; background: var(--papier); border: 1px solid var(--linia); border-radius: 0 0 0 var(--rog-maly); }
  .karta-panelu__glowa { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .karta-panelu h2 { font-size: clamp(1.6rem, 2.4vw, 2rem); }
  .siatka-pol { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 1rem 1.25rem; }
  .siatka-pol .pole--dlugie { grid-column: 1 / -1; }
  .pusto { color: var(--stal); }

  /* Pulpit */
  .liczniki { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: 1rem; }
  .liczniki li { display: grid; gap: 0.2rem; padding: 1.1rem 1.25rem; background: var(--papier); border: 1px solid var(--linia); border-radius: 0 0 0 var(--rog-maly); }
  .liczniki span { font-weight: 650; color: var(--stal); font-size: 0.95rem; }
  .liczniki strong { font-family: var(--kroj-naglowki); font-weight: 800; font-size: 2.6rem; line-height: 1; }
  .liczniki small { color: var(--stal); }
  .zmiany { display: grid; }
  .zmiana { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.8rem 0; border-top: 1px solid var(--linia); }
  .zmiana__co { font-weight: 700; }
  .zmiana__roznica { font-size: 0.95rem; overflow-wrap: anywhere; }
  .zmiana__roznica del { color: var(--stal); }
  .zmiana__roznica ins { text-decoration: none; background: #f6cf0059; padding: 0 0.2rem; }
  .zmiana__akcje { display: flex; gap: 0.5rem; flex: none; }
  .skroty { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1rem; }
  .skrot { display: grid; gap: 0.35rem; padding: 1.1rem 1.25rem; background: var(--grafit); color: var(--papier); text-decoration: none; border-radius: 0 0 0 var(--rog-maly); }
  .skrot strong { font-family: var(--kroj-naglowki); font-size: 1.6rem; line-height: 1; color: var(--zolty); }
  .skrot span { font-size: 0.95rem; }
  .skrot:hover { background: var(--probud); }
  .uwaga-panelu { max-width: none; padding: 1rem 1.25rem; border-left: 6px solid var(--zolty); background: var(--papier); }
  .zacheta-hasla { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem 2rem; padding: 1.25rem 1.5rem; background: var(--grafit); color: var(--papier); border-radius: 0 0 0 var(--rog-maly); }
  .zacheta-hasla strong { font-family: var(--kroj-naglowki); font-size: 1.8rem; line-height: 1; color: var(--zolty); }
  .zacheta-hasla p { margin-top: 0.35rem; max-width: 60ch; }
  /* Zacheta do zmiany hasla tylko wtedy, gdy panel dziala jeszcze na hasle startowym. */
  html:not(.haslo-startowe) [data-tylko-start] { display: none !important; }

  /* Konto i haslo */
  .konto-panelu { max-width: 34rem; }
  .konto-panelu .przycisk { justify-self: start; }
  .konto-panelu__blad { padding: 0.6rem 0.8rem; background: #f7e3e1; color: var(--probud); font-weight: 650; }
  .konto-panelu__ok { padding: 0.6rem 0.8rem; background: #f6cf0040; border-left: 4px solid var(--zolty-ciemny); font-weight: 650; }

  /* Oferta */
  .narzedzia { position: sticky; top: var(--gora); z-index: 5; display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 0.5rem 1rem; padding: 0.75rem 1rem; background: var(--beton-ciemny); }
  .grupa-panelu { background: var(--papier); border: 1px solid var(--linia); border-radius: 0 0 0 var(--rog-maly); }
  .grupa-panelu__glowa { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; gap: 0.75rem 1.25rem; padding: 1rem 1.25rem; border-bottom: 3px solid var(--grafit); }
  .grupa-panelu__picto { width: 2.75rem; height: 2.75rem; background: var(--grafit); -webkit-mask: var(--maska) center / contain no-repeat; mask: var(--maska) center / contain no-repeat; }
  .grupa-panelu__tytul h2 { font-size: clamp(1.6rem, 2.4vw, 2.1rem); }
  .grupa-panelu__tytul p { font-size: 0.95rem; color: var(--stal); }
  .grupa-panelu.ukryta .grupa-panelu__glowa { background: repeating-linear-gradient(135deg, #0000 0 10px, #0000000a 10px 20px); }
  .grupa-panelu.ukryta .modele-panelu { opacity: 0.55; }
  .grupa-panelu__opis { display: grid; gap: 1rem; padding: 1rem 1.25rem; background: #fbfbf8; border-bottom: 1px solid var(--linia); }

  .model-panelu {
    display: grid;
    grid-template-columns: 5.5rem minmax(10rem, 1.3fr) minmax(8rem, 1fr) minmax(9rem, 1fr) auto auto;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--linia);
  }
  .model-panelu:first-child { border-top: 0; }
  .model-panelu__foto { width: 5.5rem; height: 4.125rem; display: grid; place-items: center; background: var(--beton); overflow: hidden; }
  .model-panelu__foto img { width: auto; height: auto; max-width: 88%; max-height: 82%; object-fit: contain; }
  .model-panelu__nazwa h3 { font-size: 1.35rem; }
  .model-panelu__nazwa p { font-size: var(--t-maly); color: var(--stal); }
  .model-panelu .pole label { font-size: 0.8rem; color: var(--stal); }
  .model-panelu .pole input { padding: 0.45rem 0.6rem; font-size: 0.95rem; }
  .model-panelu__akcje { display: flex; gap: 0.4rem; }
  .model-panelu__opis { grid-column: 2 / -1; }
  .model-panelu.ukryty .model-panelu__foto, .model-panelu.ukryty .model-panelu__nazwa { opacity: 0.45; }
  .model-panelu.ukryty .model-panelu__nazwa h3 { text-decoration: line-through; }
  .model-panelu.zmieniony { box-shadow: inset 4px 0 0 var(--zolty-ciemny); }

  /* Przycisk wyboru pliku: etykieta wyglada jak przycisk, pole pliku jest schowane (sr-only). */
  .przycisk-plik { cursor: pointer; }
  .przycisk-plik:focus-within { outline: 3px solid var(--zolty); outline-offset: 2px; }
  .karta-panelu__akcje { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .karta-panelu.zmienione { box-shadow: inset 4px 0 0 var(--zolty-ciemny); }

  /* Galeria realizacji */
  .galeria-panelu { display: grid; }
  .poz-galerii {
    display: grid;
    grid-template-columns: 1.25rem 2rem 7.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--linia);
