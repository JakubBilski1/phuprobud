---
import Strona from '../../layouts/Strona.astro';
import KartaModelu from '../../components/KartaModelu.astro';
import ZapytajHandlowca from '../../components/ZapytajHandlowca.astro';
import Okruszki from '../../components/Okruszki.astro';
import { kategorie, modele } from '../../data/katalog';
import { odmiana, sierotki } from '../../lib/tekst';
---
<Strona
  tytul="Maszyny nowe"
  opis={`Katalog ${modele.length} maszyn: stopy wibracyjne, zagęszczarki i walce BOMAG, maszyny Schaeff i ładowarki gąsienicowe Gehl. PHU Probud, Komorniki.`}
>
  <div class="kontener katalog">
    <Okruszki sciezka={[{ nazwa: 'Strona główna', href: '/' }, { nazwa: 'Maszyny nowe' }]} />
    <div class="katalog__glowa">
      <h1>Maszyny nowe</h1>
      <p class="lead">{sierotki(`${odmiana(modele.length, ['model', 'modele', 'modeli'])} w ${kategorie.length} grupach. BOMAG Light Equipment sprzedajemy jako autoryzowany dystrybutor na województwa wielkopolskie i kujawsko-pomorskie.`)}</p>
    </div>

    <nav class="skoki" aria-label="Grupy maszyn">
      <ul role="list">
        {kategorie.map((k) => (
          <li>
            <a href={`#${k.id}`}>
              <span class="skoki__picto" style={`--maska:url(/piktogramy/${k.piktogram}.png)`} aria-hidden="true"></span>
              {k.nazwa}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  {kategorie.map((k, i) => (
    <section class={`grupa kontener ${i === kategorie.length - 1 ? 'grupa--ostatnia' : ''}`} id={k.id} aria-labelledby={`t-${k.id}`}>
      <div class="grupa__glowa">
        <h2 id={`t-${k.id}`}>{k.nazwa}</h2>
        <p>{sierotki(k.opis)}</p>
        <a class="grupa__link" href={k.href}>Porównaj {odmiana(k.modele.length, ['model', 'modele', 'modeli'])} w tabeli</a>
      </div>
      <div class="grupa__siatka">
        {k.modele.map((m) => <KartaModelu model={m} />)}
      </div>
    </section>
  ))}

  <ZapytajHandlowca temat="maszynę" />
</Strona>

<style>
  .katalog { padding-top: clamp(1.5rem, 3vw, 2.5rem); }
  .katalog__glowa { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 1rem 3rem; align-items: end; margin-top: 1.5rem; }
  .katalog__glowa h1 { font-size: var(--t-h1); }
  .skoki { margin-top: clamp(2rem, 4vw, 3rem); border-top: 3px solid var(--grafit); border-bottom: 1px solid var(--linia); }
  .skoki ul { display: flex; flex-wrap: wrap; }
  .skoki a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.1rem 0.8rem 0;
    margin-right: 0.4rem;
    font-weight: 650;
    text-decoration: none;
  }
  .skoki a:hover { color: var(--probud); }
  .skoki__picto { width: 2rem; height: 2rem; background: currentColor; -webkit-mask: var(--maska) center / contain no-repeat; mask: var(--maska) center / contain no-repeat; }

  .grupa { padding-top: clamp(3.5rem, 7vw, 6rem); scroll-margin-top: 5rem; }
  .grupa__glowa { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) auto; gap: 1rem 2.5rem; align-items: end; margin-bottom: 1.75rem; }
  .grupa__glowa h2 { font-size: clamp(2.2rem, 4vw, 3.6rem); }
  .grupa__glowa p { max-width: 52ch; }
  .grupa__link { font-weight: 650; white-space: nowrap; }
  .grupa__siatka { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.75rem); }
  .grupa--ostatnia { padding-bottom: var(--odstep-sekcji); }

  @media (max-width: 63.99rem) {
    .katalog__glowa, .grupa__glowa { grid-template-columns: 1fr; }
  }
</style>
