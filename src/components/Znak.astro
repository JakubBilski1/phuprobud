---
// Znak Probud: dwie sciezki z oryginalnego pliku safari-pinned-tab.svg (potrace),
// pokolorowane jak w logo: czerwien u dolu, szarosc u gory.
interface Props { class?: string; jednokolorowy?: boolean; tytul?: string }
const { class: klasa, jednokolorowy = false, tytul } = Astro.props;
---
<svg class={klasa} viewBox="0 0 260 260" role={tytul ? 'img' : undefined} aria-hidden={tytul ? undefined : 'true'} aria-label={tytul}>
  <g transform="translate(0,260) scale(0.1,-0.1)">
    <path fill={jednokolorowy ? 'currentColor' : '#505050'} d="M1320 1345 c536 -536 976 -973 978 -970 2 2 3 207 3 456 l-1 454 -517 517 -518 518 -460 0 -460 0 975 -975z" />
    <path fill={jednokolorowy ? 'currentColor' : '#881810'} d="M250 1525 c0 -779 1 -789 60 -908 84 -170 234 -290 416 -333 52 -12 179 -14 773 -12 l711 3 -980 980 -980 980 0 -710z" />
  </g>
</svg>
