---
import { handlowcy, dzialy } from '../data/firma';
import { telHref, telKrotki } from '../lib/tekst';

const linki = [
  { href: '/oferta/', tekst: 'Maszyny nowe' },
  { href: '/#uzywane', tekst: 'Używane' },
  { href: '/#finansowanie', tekst: 'Finansowanie' },
  { href: '/#realizacje', tekst: 'Realizacje' },
  { href: '/#kontakt', tekst: 'Kontakt' },
];
const sciezka = Astro.url.pathname;
const glowny = handlowcy[0];
const telGlowny = glowny.telefon!;
// Menu na telefonie: kazdy numer w osobnym wierszu (dzial i osoba z lewej, numer z prawej),
// tak samo dla dzialu z jednym i z dwoma numerami.
const telefony = dzialy.flatMap((d) => d.telefony.map((t) => ({ ...t, dzial: d.nazwa })));
---
<header class="naglowek" data-naglowek>
  <div class="naglowek__pas kontener">
    <a class="naglowek__logo" href="/" aria-label="PHU Probud, strona główna">
      <img src="/marka/probud-logo-ciemne.webp" alt="" width="489" height="98" />
    </a>

    <nav class="naglowek__nav" aria-label="Główna">
      <ul role="list">
        {linki.map((l) => (
          <li><a href={l.href} aria-current={sciezka.startsWith('/oferta') && l.href === '/oferta/' ? 'page' : undefined}>{l.tekst}</a></li>
        ))}
      </ul>
    </nav>

    <a class="naglowek__tel" href={telHref(telGlowny)}>
      <span class="naglowek__tel-ikona" aria-hidden="true"></span>
      <span class="naglowek__tel-tekst">
        <span class="naglowek__tel-podpis">Sprzedaż maszyn</span>
        <span class="naglowek__tel-numer numer">{telKrotki(telGlowny)}</span>
      </span>
    </a>

    <button class="naglowek__menu" type="button" aria-label="Otwórz menu" aria-expanded="false" aria-controls="menu-mobilne" data-menu-przycisk>
      <span class="hamburger" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <div class="menu" id="menu-mobilne" hidden data-menu>
    <nav aria-label="Główna (telefon)">
      <ul role="list">
        {linki.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={l.href} data-menu-link>
              <span>{l.tekst}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ul class="menu__telefony" role="list" style={`--i:${linki.length}`}>
      {telefony.map((t) => (
        <li>
          <span class="menu__dzial">
            {t.dzial}
            {t.osoba && <small data-osoba-imie={t.osobaId}>{t.osoba}</small>}
          </span>
          <a class="numer" href={telHref(t.numer)}>{telKrotki(t.numer)}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  // Menu na telefonie wylania sie z hamburgera (kolo odslaniane od przycisku), potem kolejno
  // wjezdzaja pozycje. Zamkniecie odwraca odslanianie, a dopiero po nim menu dostaje hidden.
  const przycisk = document.querySelector<HTMLButtonElement>('[data-menu-przycisk]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const spokoj = matchMedia('(prefers-reduced-motion: reduce)');
  const CZAS_ZAMKNIECIA = 420;
  let zamykanie = 0;

  const ustaw = (otwarte: boolean) => {
    if (!przycisk || !menu) return;
    if ((przycisk.getAttribute('aria-expanded') === 'true') === otwarte) return;
    przycisk.setAttribute('aria-expanded', String(otwarte));
    przycisk.setAttribute('aria-label', otwarte ? 'Zamknij menu' : 'Otwórz menu');
    document.documentElement.classList.toggle('menu-otwarte', otwarte);
    clearTimeout(zamykanie);
    if (otwarte) {
      menu.hidden = false;
      // Srodek kola w srodku hamburgera (nad gorna krawedzia menu), promien do najdalszego rogu.
      const p = przycisk.getBoundingClientRect();
      const m = menu.getBoundingClientRect();
      const x = p.left + p.width / 2 - m.left;
      const y = p.top + p.height / 2 - m.top;
      menu.style.setProperty('--x', `${x}px`);
      menu.style.setProperty('--y', `${y}px`);
      menu.style.setProperty('--r', `${Math.ceil(Math.hypot(Math.max(x, m.width - x), m.height - y))}px`);
      // Klasa po dwoch klatkach (stan poczatkowy musi sie narysowac), o ile menu nie zamknieto w miedzyczasie.
      requestAnimationFrame(() => requestAnimationFrame(() => {
        if (przycisk.getAttribute('aria-expanded') === 'true') menu.classList.add('menu--otwarte');
      }));
    } else {
      menu.classList.remove('menu--otwarte');
      zamykanie = window.setTimeout(() => { menu.hidden = true; }, spokoj.matches ? 0 : CZAS_ZAMKNIECIA);
    }
  };
  przycisk?.addEventListener('click', () => ustaw(przycisk.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => ustaw(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') ustaw(false); });
  matchMedia('(min-width: 64rem)').addEventListener('change', (e) => { if (e.matches) ustaw(false); });
</script>

<style>
  .naglowek {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--papier);
    border-bottom: 1px solid transparent;
  }
  @supports (animation-timeline: scroll()) {
    .naglowek { animation: linia-naglowka linear both; animation-timeline: scroll(); animation-range: 0 120px; }
    @keyframes linia-naglowka { to { border-bottom-color: var(--linia); } }
  }
  .naglowek__pas {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 4.75rem;
  }
  .naglowek__logo { flex: none; margin-right: auto; }
  .naglowek__logo img { height: clamp(28px, 2.6vw, 34px); width: auto; }

  .naglowek__nav ul { display: flex; gap: clamp(1rem, 2vw, 2rem); }
  .naglowek__nav a {
    font-weight: 600;
    text-decoration: none;
    padding-block: 0.4rem;
    background: linear-gradient(var(--probud), var(--probud)) no-repeat 0 100% / 0 2px;
    transition: background-size var(--ruch-szybki) var(--ruch-wyjscie);
  }
  .naglowek__nav a:hover, .naglowek__nav a[aria-current='page'] { background-size: 100% 2px; }

  /*
    Telefon do sprzedazy: zolta plakietka z jednym zaokraglonym rogiem (jak kadry zdjec),
    grafitowe kolko ze sluchawka (piktogram z Codeksa) i fala co kilka sekund. Po najechaniu
    kolory sie odwracaja, a sluchawka drga jak przy dzwonieniu.
  */
  .naglowek__tel {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem 1.05rem 0.4rem 0.45rem;
    background: var(--zolty);
    border-radius: 0 0 0 var(--rog-maly);
    text-decoration: none;
    transition: background var(--ruch-szybki), color var(--ruch-szybki);
  }
  .naglowek__tel-ikona {
    position: relative;
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--grafit);
    transition: background var(--ruch-szybki);
  }
  .naglowek__tel-ikona::before {
    content: '';
    position: absolute;
    inset: 0.6rem;
    background: var(--zolty);
    -webkit-mask: url(/ikony/telefon.png) center / contain no-repeat;
    mask: url(/ikony/telefon.png) center / contain no-repeat;
    transition: background var(--ruch-szybki);
  }
  .naglowek__tel-ikona::after {
    content: '';
    position: absolute;
    inset: -2px;
    border: 2px solid var(--grafit);
    border-radius: 50%;
    opacity: 0;
  }
  .naglowek__tel-tekst { display: grid; gap: 0.2rem; line-height: 1; }
  .naglowek__tel-podpis { font-size: 0.72rem; font-weight: 650; letter-spacing: 0.01em; }
  .naglowek__tel-numer { font-family: var(--kroj-naglowki); font-weight: 800; font-size: 1.5rem; }
  .naglowek__tel:hover, .naglowek__tel:focus-visible { background: var(--grafit); color: var(--zolty); }
  .naglowek__tel:hover .naglowek__tel-ikona, .naglowek__tel:focus-visible .naglowek__tel-ikona { background: var(--zolty); }
  .naglowek__tel:hover .naglowek__tel-ikona::before, .naglowek__tel:focus-visible .naglowek__tel-ikona::before { background: var(--grafit); }
  .naglowek__tel:hover .naglowek__tel-ikona::after { border-color: var(--zolty); }
  @media (prefers-reduced-motion: no-preference) {
    .naglowek__tel-ikona::after { animation: fala-telefonu 3.6s ease-out 1.2s infinite; }
    .naglowek__tel:hover .naglowek__tel-ikona::before { animation: dzwonek 0.7s ease-in-out; }
    @keyframes fala-telefonu {
      0% { transform: scale(0.95); opacity: 0.6; }
      40%, 100% { transform: scale(1.5); opacity: 0; }
    }
    @keyframes dzwonek {
      0%, 100% { rotate: 0deg; }
      15% { rotate: -16deg; }
      30% { rotate: 14deg; }
      45% { rotate: -10deg; }
      60% { rotate: 7deg; }
      75% { rotate: -3deg; }
    }
  }

  /* Hamburger -> X: kreski zjezdzaja do srodka, potem sie obracaja (przy zamykaniu odwrotnie). */
  .naglowek__menu {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
  }
  .hamburger { position: relative; display: block; width: 1.6rem; height: 1.1rem; }
  .hamburger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: top 180ms ease 180ms, transform 220ms var(--ruch-wyjscie) 0ms, opacity 120ms ease 120ms;
  }
  .hamburger span:nth-child(1) { top: 0; }
  .hamburger span:nth-child(2) { top: calc(50% - 1px); }
  .hamburger span:nth-child(3) { top: calc(100% - 2px); }
  [aria-expanded='true'] .hamburger span { transition: top 180ms ease 0ms, transform 260ms var(--ruch-wyjscie) 170ms, opacity 100ms ease 60ms; }
  [aria-expanded='true'] .hamburger span:nth-child(1) { top: calc(50% - 1px); transform: rotate(45deg); }
  [aria-expanded='true'] .hamburger span:nth-child(2) { opacity: 0; }
  [aria-expanded='true'] .hamburger span:nth-child(3) { top: calc(50% - 1px); transform: rotate(-45deg); }

  .menu {
    position: fixed;
    inset: 4.75rem 0 0 0;
    background: var(--grafit);
    color: var(--papier);
    padding: 0.75rem var(--margines) 3rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    clip-path: circle(0px at var(--x, 100%) var(--y, 0px));
    transition: clip-path 380ms cubic-bezier(0.6, 0, 0.8, 0.4);
  }
  .menu--otwarte {
    clip-path: circle(var(--r, 150vmax) at var(--x, 100%) var(--y, 0px));
    transition: clip-path 640ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Pozycje wjezdzaja od dolu jedna po drugiej, kiedy kolo juz odslania menu. */
  .menu nav li, .menu__telefony {
    opacity: 0;
    transform: translateY(1.1rem);
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .menu--otwarte nav li, .menu--otwarte .menu__telefony {
    opacity: 1;
    transform: none;
    transition: opacity 420ms ease-out, transform 560ms var(--ruch-wyjscie);
    transition-delay: calc(150ms + var(--i) * 60ms);
  }
  .menu nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem 0.7rem;
    border-bottom: 1px solid #ffffff1f;
    font-family: var(--kroj-naglowki);
    font-weight: 800;
    font-size: clamp(2.1rem, 9.5vw, 3.4rem);
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
  }
  .menu nav svg { flex: none; width: 1.6rem; height: 1.6rem; color: #ffffff73; transition: color var(--ruch-szybki), transform var(--ruch-szybki) var(--ruch-wyjscie); }
  .menu nav a:hover svg, .menu nav a:focus-visible svg { color: var(--zolty); transform: translateX(4px); }

  .menu__telefony { margin-top: 1.75rem; }
  .menu__telefony li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid #ffffff14;
  }
  .menu__dzial { color: #ffffffb3; font-size: 0.95rem; line-height: 1.25; }
  .menu__dzial small { display: block; color: #ffffff80; font-size: 0.82rem; }
  .menu__telefony a {
    font-family: var(--kroj-naglowki);
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .menu__telefony a:hover { color: var(--zolty); }

  @media (max-width: 63.99rem) {
    .naglowek__nav, .naglowek__tel { display: none; }
    .naglowek__menu { display: grid; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu, .menu--otwarte, .menu nav li, .menu__telefony, .hamburger span { transition: none !important; }
    .menu { clip-path: none; }
    .menu nav li, .menu__telefony { opacity: 1; transform: none; }
  }
  :global(html.menu-otwarte) { overflow: hidden; }
</style>
