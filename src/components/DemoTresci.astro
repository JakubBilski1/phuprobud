---
// Zmiany z panelu /admin/ (demo, localStorage) naniesione na strone po wczytaniu.
// Bez zapisanych zmian skrypt tylko sprawdza localStorage i konczy.
import { KLUCZ_MAGAZYNU } from '../lib/nadpisania';
---
<script is:inline define:vars={{ klucz: KLUCZ_MAGAZYNU }}>
  // Strona z zapisanymi zmianami czeka z pokazaniem tresci, az skrypt je naniesie (najwyzej 1,2 s).
  try {
    if (localStorage.getItem(klucz)) {
      var html = document.documentElement;
      html.classList.add('demo-wczytuje');
      setTimeout(function () { html.classList.remove('demo-wczytuje'); }, 1200);
    }
  } catch (e) { /* bez localStorage nie ma zmian do naniesienia */ }
</script>

<div class="ogloszenie" data-ogloszenie hidden>
  <p class="kontener"><span data-ogloszenie-tekst></span> <a data-ogloszenie-link hidden>Szczegóły</a></p>
</div>

<script>
  import { wczytaj, wyczysc, zastosuj } from '../lib/nadpisania';

  const zapis = wczytaj();
  if (zapis) {
    try {
      zastosuj(zapis.pola);
    } finally {
      document.documentElement.classList.remove('demo-wczytuje');
    }

    // Informacja dla osoby, ktora oglada demo: to sa jej zmiany, nie tresc z serwera.
    const pigulka = document.createElement('aside');
    pigulka.className = 'demo-pigulka';
    pigulka.setAttribute('aria-label', 'Zmiany z panelu demo');
    const liczba = Object.keys(zapis.pola).length;
    pigulka.innerHTML = `<p><strong>Podgląd zmian z panelu</strong> <span></span></p>
      <div><a href="/admin/">Otwórz panel</a><button type="button">Przywróć oryginał</button></div>`;
    pigulka.querySelector('span')!.textContent = `(${liczba}), widoczne tylko w tej przeglądarce`;
    const przycisk = pigulka.querySelector('button')!;
    przycisk.addEventListener('click', () => {
      if (przycisk.dataset.potwierdz) { wyczysc(); location.reload(); return; }
      przycisk.dataset.potwierdz = '1';
      przycisk.textContent = 'Kliknij jeszcze raz';
    });
    document.body.append(pigulka);
  }
</script>

<style is:global>
  html.demo-wczytuje body { visibility: hidden; }
  .demo-ukryte { display: none !important; }

  .ogloszenie { background: var(--probud); color: var(--papier); font-weight: 600; }
  .ogloszenie p { max-width: none; padding-block: 0.7rem; text-align: center; }
  .ogloszenie a { color: inherit; margin-left: 0.4rem; }

  .demo-uwaga {
    max-width: none;
    margin-block: 1rem;
    padding: 0.9rem 1.1rem;
    background: var(--zolty);
    border-left: 6px solid var(--grafit);
    font-weight: 600;
  }

  .demo-pigulka {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 60;
    display: grid;
    gap: 0.5rem;
    max-width: min(22rem, calc(100vw - 2rem));
    padding: 0.85rem 1rem;
    background: var(--grafit);
    color: var(--papier);
    font-size: var(--t-maly);
    line-height: 1.35;
    box-shadow: 0 10px 30px #0000003d;
    border-radius: 0 0 0 var(--rog-maly);
  }
  .demo-pigulka strong { color: var(--zolty); }
  .demo-pigulka div { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; }
  .demo-pigulka a, .demo-pigulka button { color: inherit; font-weight: 700; text-decoration: underline; text-underline-offset: 0.18em; }
  /* Na telefonie nad paskiem z numerami handlowcow. */
  @media (max-width: 63.99rem) {
    .demo-pigulka { bottom: calc(3.4rem + env(safe-area-inset-bottom) + 0.75rem); }
  }
</style>
