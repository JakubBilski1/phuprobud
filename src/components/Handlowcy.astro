---
// Ludzie, bez zdjec: centralny blok CEO, pod nim rola i numer kazdej osoby.
// Przypisania numerow do osob: src/data/firma.ts (zrodlo: ewpa.pl/kontakt).
import { szef, zespol, dzialy } from '../data/firma';
import { sierotki, telHref, telKrotki } from '../lib/tekst';
import { tresc } from '../data/tresci';

const email = dzialy.find((d) => d.id === 'sprzedaz')!.email;
const ikonaTelefonu = 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z';
---
<section class="handlowcy sekcja" id="handlowcy" aria-labelledby="handlowcy-tytul">
  <div class="kontener">
    <div class="handlowcy__glowa">
      <h2 id="handlowcy-tytul" data-tresc="handlowcy.tytul">{tresc('handlowcy.tytul')}</h2>
      <p class="lead" data-tresc="handlowcy.lead">{sierotki(tresc('handlowcy.lead'))}</p>
    </div>

    <article class="szef">
      {szef.tytul && <p class="szef__tytul" data-osoba-tytul={szef.id}>{szef.tytul}</p>}
      <h3 class="szef__imie" data-osoba-imie={szef.id}>{szef.imie} {szef.nazwisko}</h3>
      <p class="szef__rola" data-osoba-rola={szef.id}>{szef.rola}</p>
    </article>

    <ul class="zespol" role="list">
      {zespol.map((o) => (
        <li class="osoba">
          <h3 class="osoba__rola" data-osoba-rola={o.id}>{o.rola}</h3>
          <p class="osoba__imie" data-osoba-imie={o.id}>{o.imie} {o.nazwisko}</p>
          {o.telefon && (
            <a class="osoba__tel numer" href={telHref(o.telefon)} aria-label={`Zadzwoń: ${o.imie} ${o.nazwisko}, ${o.rola.toLowerCase()}, ${telKrotki(o.telefon)}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ikonaTelefonu} fill="currentColor" /></svg>
              {telKrotki(o.telefon)}
            </a>
          )}
        </li>
      ))}
    </ul>

    <p class="handlowcy__email">E-mail działu sprzedaży: <a href={`mailto:${email}`}>{email}</a></p>
  </div>
</section>

<style>
  .handlowcy__glowa {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 1rem 3rem;
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .handlowcy__glowa .lead { max-width: 46ch; }

  /* Centralny blok: sam tekst na zoltym, wysrodkowany. */
  .szef {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3rem);
    background: var(--zolty);
    border-radius: 0 0 0 var(--rog);
  }
  .szef__tytul {
    font-family: var(--kroj-naglowki);
    font-weight: 800;
    font-size: var(--t-numer);
    line-height: 1;
  }
  .szef__imie { margin-top: 0.75rem; font-size: clamp(2.8rem, 6.4vw, 6rem); line-height: 0.9; }
  .szef__rola { margin-top: 1rem; font-weight: 600; font-size: var(--t-lead); }

  /* Pod spodem: rola, osoba i numer, rowne kolumny na szerokosc bloku. */
  .zespol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    margin-top: clamp(0.75rem, 1.5vw, 1.25rem);
  }
  .osoba {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(1.5rem, 3vw, 2.25rem) 1rem;
    background: var(--beton);
    border-radius: 0 0 0 var(--rog-maly);
  }
  .osoba__rola { font-size: clamp(1.6rem, 2.2vw, 2rem); line-height: 0.95; }
  .osoba__imie { margin-top: 0.35rem; font-weight: 600; }
  .osoba__tel {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.75rem;
    font-family: var(--kroj-naglowki);
    font-weight: 800;
    font-size: clamp(1.9rem, 2.8vw, 2.5rem);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .osoba__tel svg { width: 0.55em; height: 0.55em; }
  .osoba__tel:hover { color: var(--probud); }

  .handlowcy__email { margin: 1.25rem auto 0; font-weight: 600; text-align: center; }

  @media (max-width: 63.99rem) {
    .handlowcy__glowa { grid-template-columns: 1fr; }
  }
</style>
